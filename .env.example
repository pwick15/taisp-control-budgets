# cp .env.example .env  (Inspect loads .env from the working directory automatically)
ANTHROPIC_API_KEY=
# Only if you switch a model to OpenAI directly, e.g. MONITOR=openai/gpt-6-luna
OPENAI_API_KEY=
# A litellm proxy (OpenAI-compatible) can front OpenAI, DeepInfra, etc. Route any
# monitor through it with Inspect's openai-api provider and the "litellm" service
# prefix (openai-api reads <SERVICE>_API_KEY and <SERVICE>_BASE_URL):
#   MONITOR=openai-api/litellm/openai/gpt-6-luna
#   MONITOR=openai-api/litellm/deepinfra/zai-org/GLM-5.3
#   MONITOR=openai-api/litellm/deepinfra/openai/gpt-oss-120b
# A reasoning monitor behind such a proxy needs MONITOR_STREAM=1, or the gateway
# cuts its long (non-streamed) response at ~90s under concurrency with a 504.
LITELLM_API_KEY=
LITELLM_BASE_URL=https://your-litellm-host
# Free-tier providers (no credit card). Fill only the ones you use.
GOOGLE_API_KEY=
MISTRAL_API_KEY=
# Optional model overrides
# UNTRUSTED_MODEL=anthropic/claude-sonnet-5-5
# TRUSTED_MODEL=anthropic/claude-haiku-4-5-20251001
# Free-tier example: UNTRUSTED_MODEL=google/gemini-2.5-flash TRUSTED_MODEL=mistral/ministral-8b-latest
# Keep concurrency low on free tiers to stay under per-minute limits
# MAX_CONNECTIONS=1
